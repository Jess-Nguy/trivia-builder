{
  "name": "trivia-builder",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo of trivia tools: the Trivia Builder app in apps/builder and standalone tools in tools/.",
  "type": "module",
  "workspaces": [
    "apps/builder",
    "apps/builder/client",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm -w trivia-builder-client run dev",
    "party": "npm -w trivia-builder-client run dev -- --host",
    "build": "npm -w trivia-builder-client run build",
    "start": "node apps/builder/server/index.js",
    "test": "node --test apps/*/test/*.test.js tools/*/test/*.test.js",
    "harvest": "node tools/harvester/src/cli.js"
  }
}
